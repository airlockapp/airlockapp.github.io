---
import DocsLayout from "../../layouts/docs.astro";
---

<DocsLayout title="Airlock Documentation">
    <div class="space-y-8">
        <div>
            <h1 class="text-3xl md:text-4xl font-bold">Documentation</h1>
            <p class="text-muted-foreground mt-2">
                Enterprise deployment guides, developer reference, and security
                documentation for Airlock.
            </p>
        </div>

        <!-- Search -->
        <div class="relative">
            <input
                type="text"
                id="docs-search"
                placeholder="Search documentation..."
                class="w-full rounded-xl border border-border/50 bg-muted/30 px-4 py-3 pl-10 text-sm placeholder:text-muted-foreground/50 focus:outline-none focus:ring-2 focus:ring-airlock-violet-light/50"
            />
            <svg
                class="absolute left-3 top-3.5 h-4 w-4 text-muted-foreground/50"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                ></path>
            </svg>
        </div>

        <!-- Getting started -->
        <div class="space-y-4" data-docs-category>
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-airlock-violet-light"
                ></span>
                Getting started
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a
                    href="/docs/getting-started"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-airlock-violet-light/30 transition-all md:col-span-2"
                    data-doc-title="Getting Started Enterprise Deployment Gateway"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-airlock-violet/15 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-airlock-violet-light"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-airlock-violet-light transition-colors"
                        >
                            Getting started
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Deploy Gateway, enforcers, and Mobile Approver in your
                            environment
                        </p>
                    </div>
                </a>
            </div>
        </div>

        <!-- CLI & Shells -->
        <div class="space-y-4" data-docs-category>
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-airlock-cyan"></span>
                CLI & Shells
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a
                    href="/docs/cli"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-airlock-cyan/30 transition-all"
                    data-doc-title="Airlock CLI User Guide"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-airlock-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-airlock-cyan"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-airlock-cyan transition-colors"
                        >
                            Airlock CLI
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Reference CLI enforcer — pair with your enterprise Gateway
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/shells"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-airlock-cyan/30 transition-all"
                    data-doc-title="Shell Integration Bash Zsh PowerShell"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-airlock-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-airlock-cyan"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4 6h16M4 12h16M4 18h7"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-airlock-cyan transition-colors"
                        >
                            Shell integration
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Bash, Zsh, and PowerShell plugins — approve every command
                        </p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Developer -->
        <div class="space-y-4" data-docs-category>
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-emerald-500"
                ></span>
                Developer
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a
                    href="/docs/developer-guide"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="Developer Guide Enforcer Apps Gateway SDK"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-emerald-500"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-emerald-500 transition-colors"
                        >
                            Developer Guide
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Build enforcer apps with the Integrations Gateway SDK
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/airlock-apps"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="Airlock Apps Enforcer App Client ID Client Secret Consent"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-emerald-500"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-emerald-500 transition-colors"
                        >
                            What Are Airlock Apps?
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Client ID, client secret, and user consent on the gateway
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/sdk"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="Gateway Client SDKs .NET Python TypeScript Go Rust"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-emerald-500"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-emerald-500 transition-colors"
                        >
                            Gateway Client SDKs
                        </p>
                        <p class="text-xs text-muted-foreground">
                            .NET, Python, TypeScript, Go, and Rust client
                            libraries
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/sdk/dotnet"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title=".NET SDK C# Airlock Gateway"
                >
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-purple-600/15 text-purple-500 text-sm font-bold">C#</span>
                    <div>
                        <p class="font-medium text-sm group-hover:text-emerald-500 transition-colors">.NET SDK</p>
                        <p class="text-xs text-muted-foreground">Airlock.Gateway.Sdk — NuGet</p>
                    </div>
                </a>
                <a
                    href="/docs/sdk/python"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="Python SDK Airlock Gateway"
                >
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-yellow-500/15 text-yellow-500 text-sm font-bold">Py</span>
                    <div>
                        <p class="font-medium text-sm group-hover:text-emerald-500 transition-colors">Python SDK</p>
                        <p class="text-xs text-muted-foreground">airlock-gateway — PyPI</p>
                    </div>
                </a>
                <a
                    href="/docs/sdk/typescript"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="TypeScript SDK Airlock Gateway"
                >
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-blue-500/15 text-blue-500 text-sm font-bold">TS</span>
                    <div>
                        <p class="font-medium text-sm group-hover:text-emerald-500 transition-colors">TypeScript SDK</p>
                        <p class="text-xs text-muted-foreground">@airlockapp/gateway-sdk — NPM</p>
                    </div>
                </a>
                <a
                    href="/docs/sdk/go"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="Go SDK Airlock Gateway"
                >
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-cyan-500/15 text-cyan-500 text-sm font-bold">Go</span>
                    <div>
                        <p class="font-medium text-sm group-hover:text-emerald-500 transition-colors">Go SDK</p>
                        <p class="text-xs text-muted-foreground">airlock — pkg.go.dev</p>
                    </div>
                </a>
                <a
                    href="/docs/sdk/rust"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="Rust SDK Airlock Gateway"
                >
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-orange-600/15 text-orange-500 text-sm font-bold">Rs</span>
                    <div>
                        <p class="font-medium text-sm group-hover:text-emerald-500 transition-colors">Rust SDK</p>
                        <p class="text-xs text-muted-foreground">airlock-gateway — crates.io</p>
                    </div>
                </a>
                <a
                    href="/docs/n8n"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="n8n Airlock Gateway nodes workflow automation"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center text-xs font-bold text-emerald-500"
                    >
                        n8n
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-emerald-500 transition-colors"
                        >
                            n8n integration
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Echo and Enforcer nodes for workflow approvals
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/openclaw"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="OpenClaw Airlock plugin agent tools approval"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center text-xs font-bold text-emerald-500"
                    >
                        OC
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-emerald-500 transition-colors"
                        >
                            OpenClaw plugin
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Gateway-backed approval for AI tool execution
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/openclaw-demo"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-emerald-500/30 transition-all"
                    data-doc-title="OpenClaw Telegram demo Airlock approval walkthrough"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center text-xs font-bold text-emerald-500"
                    >
                        TG
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-emerald-500 transition-colors"
                        >
                            OpenClaw + Telegram demo
                        </p>
                        <p class="text-xs text-muted-foreground">
                            End-to-end walkthrough: bot, consent, pairing, approvals
                        </p>
                    </div>
                </a>
            </div>
        </div>


        <!-- Enforcer samples -->
        <div class="space-y-4" data-docs-category>
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-indigo-500"></span>
                Enforcer samples & reference
            </h2>
            <p class="text-sm text-muted-foreground max-w-3xl">
                Open-source Host Enforcer implementations on
                <a href="https://github.com/airlockapp/extensions" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">GitHub</a>.
                Fork and adapt them for your enterprise deployment — point each integration at
                <code class="rounded bg-muted px-1 text-xs">https://&lt;your-gateway-host&gt;</code>.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a href="/docs/claude-code" class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-indigo-500/30 transition-all" data-doc-title="Claude Code Enforcer Sample Reference">
                    <img src="/enforcers/claude-code.svg" alt="Claude Code" class="w-10 h-10 rounded-lg" />
                    <div>
                        <p class="font-medium text-sm group-hover:text-indigo-400 transition-colors">Claude Code sample</p>
                        <p class="text-xs text-muted-foreground">Reference enforcer for Anthropic Claude Code agents</p>
                    </div>
                </a>
                <a href="/docs/cursor" class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-indigo-500/30 transition-all" data-doc-title="Cursor Enforcer Sample Reference">
                    <img src="/enforcers/cursor.png" alt="Cursor" class="w-10 h-10 rounded-lg" />
                    <div>
                        <p class="font-medium text-sm group-hover:text-indigo-400 transition-colors">Cursor sample</p>
                        <p class="text-xs text-muted-foreground">Reference enforcer for Cursor IDE hook interception</p>
                    </div>
                </a>
                <a href="/docs/windsurf" class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-indigo-500/30 transition-all" data-doc-title="Windsurf Enforcer Sample Reference">
                    <img src="/enforcers/windsurf.png" alt="Windsurf" class="w-10 h-10 rounded-lg" />
                    <div>
                        <p class="font-medium text-sm group-hover:text-indigo-400 transition-colors">Windsurf sample</p>
                        <p class="text-xs text-muted-foreground">Reference enforcer for Windsurf / Codeium IDE</p>
                    </div>
                </a>
                <a href="/docs/antigravity" class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-indigo-500/30 transition-all" data-doc-title="Antigravity Enforcer Sample Reference">
                    <img src="/enforcers/antigravity.png" alt="Antigravity" class="w-10 h-10 rounded-lg" />
                    <div>
                        <p class="font-medium text-sm group-hover:text-indigo-400 transition-colors">Antigravity sample</p>
                        <p class="text-xs text-muted-foreground">Reference enforcer for Google Antigravity</p>
                    </div>
                </a>
                <a href="/docs/copilot" class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-indigo-500/30 transition-all" data-doc-title="Copilot Enforcer Sample Reference">
                    <img src="/enforcers/copilot.png" alt="Copilot" class="w-10 h-10 rounded-lg" />
                    <div>
                        <p class="font-medium text-sm group-hover:text-indigo-400 transition-colors">Copilot sample</p>
                        <p class="text-xs text-muted-foreground">Reference enforcer for GitHub Copilot</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Security & Legal -->
        <div class="space-y-4" data-docs-category>
            <h2 class="text-xl font-semibold flex items-center gap-2">
                <span class="w-1.5 h-6 rounded-full bg-airlock-cyan"></span>
                Security & Legal
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a
                    href="/docs/data-security"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-airlock-cyan/30 transition-all"
                    data-doc-title="Data Security"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-airlock-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-link"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-link transition-colors"
                        >
                            Data Security
                        </p>
                        <p class="text-xs text-muted-foreground">
                            How Airlock protects your data with cryptographic
                            guarantees
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/privacy"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-airlock-cyan/30 transition-all"
                    data-doc-title="Privacy Policy"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-airlock-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-link"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-link transition-colors"
                        >
                            Privacy Policy
                        </p>
                        <p class="text-xs text-muted-foreground">
                            What data we collect and how we handle it
                        </p>
                    </div>
                </a>
                <a
                    href="/docs/eula"
                    class="doc-card group flex items-center gap-4 p-4 rounded-xl border border-border/50 bg-card/50 hover:shadow-md hover:border-airlock-cyan/30 transition-all"
                    data-doc-title="End User License Agreement EULA Terms"
                >
                    <div
                        class="w-10 h-10 rounded-lg bg-airlock-cyan/10 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-link"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <p
                            class="font-medium text-sm group-hover:text-link transition-colors"
                        >
                            End User License Agreement
                        </p>
                        <p class="text-xs text-muted-foreground">
                            Terms for using the Mobile Approver and end-user
                            services
                        </p>
                    </div>
                </a>
            </div>
